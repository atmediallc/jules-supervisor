# ==============================================================================
# JULES SUPERVISOR — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=3000
WORKER_PORT=3001
LOG_LEVEL=info

# Supervisor Execution Mode
# Values: DISABLED | DRY_RUN | ASSISTED | AUTO_RESPOND | FULL_AUTO
# Default is DRY_RUN (Never performs mutations against Jules API)
SUPERVISOR_MODE=DRY_RUN
AUTO_RESPOND_ENABLED=false
AUTO_PLAN_APPROVAL_ENABLED=false
MAX_SESSION_CYCLES=5
MAX_AI_RETRIES=3
POLL_INTERVAL_MS=5000
CONFIDENCE_THRESHOLD=0.85

# Google Jules API
JULES_API_BASE_URL=https://jules.googleapis.com/v1alpha
JULES_API_KEY=your-google-jules-api-key-here
JULES_API_TIMEOUT_MS=15000
JULES_RATE_LIMIT_RPS=5

# AI Provider / OmniRoute (OpenAI Compatible)
AI_PROVIDER_TYPE=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4o
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=2048
ALLOW_INSECURE_LOCAL_ENDPOINTS=false
TRUSTED_INTERNAL_AI_HOSTS=localhost,127.0.0.1,omniroute

# PostgreSQL Persistence (Drizzle ORM)
DATABASE_URL=postgresql://jules_user:jules_password@localhost:5432/jules_supervisor?sslmode=disable
POSTGRES_HOST_PORT=5439
DB_MAX_CONNECTIONS=10

# Redis & Queueing (BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6389
REDIS_ENABLED=true
USE_IN_MEMORY_QUEUE_FALLBACK=false

# Integration Testing URLs (optional overrides)
TEST_DATABASE_URL=postgresql://jules_user:jules_password@localhost:5439/jules_supervisor?sslmode=disable
TEST_REDIS_URL=redis://localhost:6389

# Security & Dashboard Auth
SESSION_SECRET=a_very_secret_32_char_hex_or_string_here_12345
CORS_ORIGIN=http://localhost:3000
